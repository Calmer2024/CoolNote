{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoolNote",
  "version": "0.1.14",
  "identifier": "com.calmer.coolnote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": ["main"],
      "csp": null
    },
    "windows": [
      {
        "title": "CoolNote",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": { "language": "zh-CN" },
      "nsis": { "languages": ["SimpChinese"] }
    }
  }
}
