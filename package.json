{
  "name": "coolnote",
  "private": true,
  "version": "0.1.17",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "check:icons": "node scripts/check-icons.mjs",
    "check:prototype": "node scripts/check-prototype-contract.mjs",
    "check:editor-performance": "node scripts/check-editor-performance-contract.mjs",
    "build": "npm run check:icons && npm run check:prototype && npm run check:editor-performance && tsc && vite build",
    "preview": "vite preview",
    "perf:gate": "cargo run --release --manifest-path src-tauri/Cargo.toml --example performance_gate",
    "perf:editor": "cargo run --release --manifest-path src-tauri/Cargo.toml --example editor_performance_gate",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tiptap/core": "^3.30.0",
    "@tiptap/extension-code-block-lowlight": "^3.30.0",
    "@tiptap/extension-highlight": "^3.30.0",
    "@tiptap/extension-image": "^3.30.0",
    "@tiptap/extension-link": "^3.30.0",
    "@tiptap/extension-mathematics": "^3.30.0",
    "@tiptap/extension-placeholder": "^3.30.0",
    "@tiptap/extension-table": "^3.30.0",
    "@tiptap/extension-table-cell": "^3.30.0",
    "@tiptap/extension-table-header": "^3.30.0",
    "@tiptap/extension-table-row": "^3.30.0",
    "@tiptap/extension-task-item": "^3.30.0",
    "@tiptap/extension-task-list": "^3.30.0",
    "@tiptap/extension-underline": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^3.0.4",
    "katex": "^0.18.4",
    "lowlight": "^3.3.0",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
