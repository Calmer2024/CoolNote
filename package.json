{
  "name": "coolnote",
  "private": true,
  "version": "1.0.18",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "check:icons": "node scripts/check-icons.mjs",
    "check:prototype": "node scripts/check-prototype-contract.mjs",
    "check:editor-performance": "node scripts/check-editor-performance-contract.mjs",
    "check:gallery": "node scripts/check-gallery-contract.mjs",
    "check:tasks": "node scripts/check-task-contract.mjs",
    "test:tasks": "vitest run src/features/tasks/TaskWorkspace.test.tsx",
    "test:gallery": "vitest run src/features/gallery/galleryDragDrop.test.ts",
    "test:editor": "vitest run src/features/editor/markdownShortcuts.test.ts src/features/editor/editorShortcuts.test.ts src/features/editor/mermaidNode.test.ts src/features/editor/imageLayout.test.ts src/features/editor/editorSizing.test.ts src/features/editor/stableBlockIds.test.ts src/features/editor/highlightBlock.test.ts src/features/editor/attachmentResources.test.ts src/features/editor/linkPolicy.test.ts src/features/editor/webResource.test.ts src/features/editor/document.test.ts src/features/outline/Outline.test.ts src/features/export/export.test.ts src/features/jottings/shareTemplate.test.ts src/features/jottings/jottingDragDrop.test.ts src/shared/components/Overlay.test.tsx src/app/navigationShortcuts.test.ts src/features/notes/useNotes.test.tsx",
    "build": "npm run check:icons && npm run check:prototype && npm run check:editor-performance && npm run check:gallery && npm run check:tasks && npm run test:tasks && npm run test:gallery && npm run test:editor && tsc && vite build",
    "preview": "vite preview",
    "perf:gate": "node scripts/rust-build.mjs perf-gate",
    "perf:editor": "node scripts/rust-build.mjs perf-editor",
    "perf:attachments:backend": "node scripts/rust-build.mjs perf-attachments",
    "rust:test": "node scripts/rust-build.mjs test",
    "rust:clippy": "node scripts/rust-build.mjs clippy",
    "rust:clean": "node scripts/rust-build.mjs clean",
    "perf:attachments:frontend": "vitest run src/features/editor/attachmentEditorPerformance.test.ts --reporter=verbose",
    "perf:attachments": "npm run perf:attachments:frontend && npm run perf:attachments:backend",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/core": "^3.30.0",
    "@tiptap/extension-code-block-lowlight": "^3.30.0",
    "@tiptap/extension-highlight": "^3.30.0",
    "@tiptap/extension-image": "^3.30.0",
    "@tiptap/extension-link": "^3.30.0",
    "@tiptap/extension-mathematics": "^3.30.0",
    "@tiptap/extension-placeholder": "^3.30.0",
    "@tiptap/extension-table": "^3.30.0",
    "@tiptap/extension-table-cell": "^3.30.0",
    "@tiptap/extension-table-header": "^3.30.0",
    "@tiptap/extension-table-row": "^3.30.0",
    "@tiptap/extension-task-item": "^3.30.0",
    "@tiptap/extension-task-list": "^3.30.0",
    "@tiptap/extension-underline": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^3.0.4",
    "katex": "^0.18.4",
    "lowlight": "^3.3.0",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
